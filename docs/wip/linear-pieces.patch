+            let mut nb = Builder::default();
+            let at = nb.append(&ops, &Op::Var);
+            Program { code: Code::new(nb, vec![at[root]]), vars: vars.clone(), used_params: self.used_params.clone() }
+        };
+        Some((make(g), make(a)))
+    }
